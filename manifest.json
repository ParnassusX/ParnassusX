{
  "name": "Chrome Extension Starter",
  "description": "A basic starter template for a Chrome Extension.",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "permissions": [
    "windows",
    "tabs",
    "storage",
    "system.display"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
