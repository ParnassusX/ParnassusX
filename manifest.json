{
  "name": "__MSG_appName__",
  "description": "__MSG_appDescription__",
  "version": "0.2.0",
  "minimum_chrome_version": "123",
  "default_locale": "en",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "windows",
    "tabs",
    "storage",
    "system.display",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "apply-preset-1": {
      "suggested_key": {
        "default": "Ctrl+Shift+1",
        "mac": "Command+Shift+1"
      },
      "description": "__MSG_cmd1__"
    },
    "apply-preset-2": {
      "suggested_key": {
        "default": "Ctrl+Shift+2",
        "mac": "Command+Shift+2"
      },
      "description": "__MSG_cmd2__"
    },
    "apply-preset-3": {
      "suggested_key": {
        "default": "Ctrl+Shift+3",
        "mac": "Command+Shift+3"
      },
      "description": "__MSG_cmd3__"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
